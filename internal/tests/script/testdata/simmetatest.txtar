! exec gosim test -run=Other -v .
stderr 'metatesting.*(unsupported application package os/exec|host-only or unknown compatibility package github.com/neria-cloud/gosim/internal/compat/selected)'

! exec gosim test -run=Self -v .
stderr 'metatesting.*(unsupported application package os/exec|host-only or unknown compatibility package github.com/neria-cloud/gosim/internal/compat/selected)'

-- machinecrash_test.go --
package behavior_test

import (
	"testing"

    "github.com/neria-cloud/gosim/metatesting"
)

func TestSelf(t *testing.T) {
    mt := metatesting.ForPackage(t, metatesting.Options{})
    metatesting.CheckDeterministic(t, mt)
}

func TestOther(t *testing.T) {
    mt := metatesting.ForOtherPackage(t, "foo", metatesting.Options{})
    metatesting.CheckDeterministic(t, mt)
}
