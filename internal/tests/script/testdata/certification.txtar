# Public commands work without certification or pending tuple declarations.
exec gosim-user translate .
exec gosim-user test -v .
stdout 'PASS'
exec gosim-user build-tests .
exec gosim-user lookup-test .
stdout '"binary"'

# The legacy candidate entry resolves the same evidence-independent identity.
mkdir .gosim/identity
exec gosim-user resolve-build
stdout '"schema":2'
! stdout 'certification'
cp stdout .gosim/identity/public.json
exec gosim resolve-build
cmp stdout .gosim/identity/public.json

! exec gosim-user test -force-unsupported .
stderr 'flag provided but not defined'
! exec gosim test -features net .
stderr 'rt'
! exec gosim test -go go1.27.0 .
stderr 'unsupported'
-- probe_test.go --
package fixture
import "testing"
func TestProbe(t *testing.T) {}
