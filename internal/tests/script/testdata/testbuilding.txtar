# This tests verifies the metatest test binary building and caching logic.

# Cached metatest fails without binary
! exec go test -ldflags=-checklinkname=0 -tags=linkname -v .
stdout 'Could not find pre-built gosim test binary'

# Inner test should work
exec gosim test -v .
stdout 'inside gosim hello'

# Uncached metatest works
exec go test -ldflags=-checklinkname=0 -tags=linkname -v -count=1 .
stdout 'looks like an uncached test run.*build-tests'
stdout 'inside gosim hello'

# Build binary
exec gosim build-tests .

# Cached metatest now works
exec go test -ldflags=-checklinkname=0 -tags=linkname -v .
stdout 'Using pre-built gosim test binary'
stdout 'inside gosim hello'

# Uncached metatest still works
exec go test -ldflags=-checklinkname=0 -tags=linkname -v -count=1 .
stdout 'looks like an uncached test run.*build-tests'
stdout 'inside gosim hello'

# Touching unchanged input preserves a content-checked artifact
exec touch test_test.go
exec go test -ldflags=-checklinkname=0 -tags=linkname -v .
stdout 'inside gosim hello'

# Changing source invalidates the package artifact
cp changed.go.txt test_test.go

# Cached metatest no longer works
! exec go test -ldflags=-checklinkname=0 -tags=linkname -v .
stdout 'Could not find pre-built gosim test binary'

# Uncached metatest still works
exec go test -ldflags=-checklinkname=0 -tags=linkname -v -count=1 .
stdout 'looks like an uncached test run.*build-tests'
stdout 'inside gosim hello'

-- metatest_test.go --
//go:build !sim

package behavior_test

import (
	"testing"

    "github.com/neria-cloud/gosim/metatesting"
)

func TestSelf(t *testing.T) {
    mt := metatesting.ForPackage(t, metatesting.Options{})
	_, err := mt.Run(t, &metatesting.RunConfig{
		Test:     "TestHello",
		Seed:     1,
	})
	if err != nil {
		t.Fatal(err)
	}
}

-- test_test.go --
//go:build sim

package behavior_test

import (
    "testing"
)

func TestHello(t *testing.T) {
    t.Log("inside gosim hello")
}

-- changed.go.txt --
//go:build sim

package behavior_test

import "testing"
func TestHello(t *testing.T) { t.Log("inside gosim hello changed") }
