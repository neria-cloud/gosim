          "reason": "Native raw syscalls cannot enter application execution. Named syscall wrappers replace callers; no Linux host fallback."
        },
        {
          "path": "internal/strconv",
          "mode": "translate",
          "reason": "Go 1.26 internal integer/error helpers replace internal/itoa and runtime/strconv; values and errors remain translated."
        },
        {
          "path": "testing/cryptotest",
          "mode": "reject",
          "reason": "SetGlobalRandom mutates native process-wide crypto DRBG state through private linknames; simulation owns machine/application entropy."
